{
  "name": "vpt",
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "description": "多套VitePress && vuePress主题集合，包含文档主题、博客主题、增强官方主题等",
  "scripts": {
    "build": "pnpm -r  build",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "generate:dts": "node src/scripts/generate-dts.cjs",
    "iall": "pnpm -r install",
    "upall": "pnpm -r update --latest",
    "change": "pnpm dlx changelogithub --dry",
    "release": "bumpp"
  },
  "keywords": [
    "vitepress",
    "vitepress-theme",
    "hefung",
    "docs-theme",
    "blog-theme"
  ],
  "author": "hefung",
  "license": "MIT",
  "devDependencies": {
    "bumpp": "^12.3.0",
    "@biomejs/biome": "^2.6.4",
    "mermaid": "^12.3.0"
  }
}