{
  "name": "@hefou/dux",
  "version": "1.0.1",
  "description": "基于VitePress 文档主题，适配AI知识库与项目文档",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/esm/dux.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./config": {
      "types": "./dist/types/config.d.ts",
      "import": "./dist/esm/config.js",
      "require": "./dist/cjs/config.cjs"
    },
    "./shims/sanitize-url": {
      "types": "./dist/types/shims/sanitize-url.d.ts",
      "import": "./dist/esm/shims/sanitize-url.js",
      "require": "./dist/cjs/shims/sanitize-url.cjs"
    },
    "./shims/dayjs": {
      "types": "./dist/types/shims/dayjs.d.ts",
      "import": "./dist/esm/shims/dayjs.js",
      "require": "./dist/cjs/shims/dayjs.cjs"
    },
    "./dist/index.css": "./dist/esm/dux.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && (vue-tsc --declaration --emitDeclarationOnly --outDir dist/types || true)",
    "build:watch": "vite build --watch",
    "dev": "pnpm run build:watch",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm publish --access public"
  },
  "dependencies": {
    "@iconify/tailwind4": "^1.2.3",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "minisearch": "^7.2.0",
    "vitepress-mermaid-renderer": "^1.2.3"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.43",
    "@iconify/tailwind": "^1.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "tailwindcss": "^4.3.5",
    "@vitejs/plugin-vue": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vitepress": "^1.6.4 || >=2.0.0-alpha.18 <3.0.0",
    "vue": "^3.5.0"
  },
  "keywords": [
    "vitepress",
    "theme",
    "hcf-ai",
    "vue",
    "documentation"
  ],
  "author": "hefow",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hefou/vpt",
    "directory": "packages/dux"
  }
}